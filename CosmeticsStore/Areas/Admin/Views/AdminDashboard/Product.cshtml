@model IEnumerable<DataLayer.Models.Product>
@{
    Layout = null;
    int c = 0;
}

<div class="p-2 mb-3 admindashboardshadow admindashboarddiv container">
    <h1 class="text-body/16 fw-bold md:mb-6 mb-8 page-title">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-box-seam ms-2" viewBox="0 0 16 16">
            <path d="M8.186 1.113a.5.5 0 0 0-.372 0L1.846 3.5l2.404.961L10.404 2zm3.564 1.426L5.596 5 8 5.961 14.154 3.5zm3.25 1.7-6.5 2.6v7.922l6.5-2.6V4.24zM7.5 14.762V6.838L1 4.239v7.923zM7.443.184a1.5 1.5 0 0 1 1.114 0l7.129 2.852A.5.5 0 0 1 16 3.5v8.662a1 1 0 0 1-.629.928l-7.185 2.874a.5.5 0 0 1-.372 0L.63 13.09a1 1 0 0 1-.63-.928V3.5a.5.5 0 0 1 .314-.464z" />
        </svg>آخرین کالاهای اضافه شده
    </h1>
    <div class="table-container">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-primary">
                    <tr>
                        <th scope="col">ردیف</th>
                        <th scope="col">تصویر اصلی</th>
                        <th scope="col">کد کالا</th>
                        <th scope="col">نام کالا</th>
                        <th scope="col">مبلغ</th>
                        <th scope="col">درصد تخفیف</th>
                        <th scope="col">وضعیت</th>
                        <th scope="col">عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model)
                    {
                        c = c + 1;
                        <tr>
                            <td>@c</td>
                            <td><img src="~/Content/Images/@product.ImageName1" class="h-10 w-auto" style="border-radius: 50%;" /></td>
                            <td>@product.ProductCode</td>
                            <td>@product.ProductName</td>
                            <td>@product.Price.ToString("N0")</td>
                            <td>@product.DiscountPercent%</td>
                            @if (product.IsActive == true)
                            {

                                <td>فعال</td>
                            }
                            else
                            {
                                <td>غیرفعال</td>
                            }
                            <td><a class="btn btn-sm btn-info">مشاهده</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
