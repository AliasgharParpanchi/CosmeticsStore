<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - GlowVibes</title>
    <link rel="stylesheet" href="~/Content/StyleSheetSite.css" />
    <link href="/Content/css/style.css" rel="stylesheet">
    <link href="/Content/css/responsive.css" rel="stylesheet">
    <link href="~/Content/bootstrap.rtl.css" rel="stylesheet" />
    <link href="~/Content/bootstrap-reboot.rtl.css" rel="stylesheet" />
</head>
<body>
    <div id="_rht_toaster" style="position: fixed; z-index: 9999; inset: 80px 16px 32px; pointer-events: none;" class="!z-top-of-chatbot-plus2"></div>
    <section>
        <a class="block h-10 w-full lg:h-[60px]" href="/" elementtrackingid="cta_click" elementname="top_header">
            <picture data-sentry-element="picture" data-sentry-source-file="header-banner.tsx">
                <source media="(min-width: 1200px)" srcset="~/Content/Images/Site/banner.jpeg">
                <img src="~/Content/Images/Site/banner.jpeg" alt="ارسال رایگان" class="h-full w-full object-cover">
            </picture>
        </a>
        <header id="header" class="sticky top-0 w-full bg-white sm:px-2 sm:py-3 shadow:sm transition-all duration-500 lg:p-0 z-top-of-chatbot-plus1" data-sentry-component="HeaderContent" data-sentry-source-file="header-content.tsx">
            <div class="layout-container position-relative z-10 flex items-center justify-content-between bg-white lg:h-[90px]" data-sentry-component="MainBar" data-sentry-source-file="main-bar.tsx">
                <div class="d-flex items-center gap-2:sm lg:gap-4">
                    <label class="flex pointer-event lg:hidden" data-sentry-component="MenuButton" data-sentry-source-file="menu-button.tsx" role="button" id="MenuButton">
                        <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="none" viewBox="0 0 24 24" class="h-6 w-6 text-neutral-800" data-sentry-element="svg" data-sentry-source-file="Menu.tsx" data-sentry-component="SvgMenu"><path fill="currentColor" d="M21 7.75H3c-.41 0-.75-.34-.75-.75s.34-.75.75-.75h18c.41 0 .75.34.75.75s-.34.75-.75.75M21 12.75H3c-.41 0-.75-.34-.75-.75s.34-.75.75-.75h18c.41 0 .75.34.75.75s-.34.75-.75.75M21 17.75H3c-.41 0-.75-.34-.75-.75s.34-.75.75-.75h18c.41 0 .75.34.75.75s-.34.75-.75.75" data-sentry-element="path" data-sentry-source-file="Menu.tsx"></path></svg>
                    </label>
                    <a class="lg:flex-initial" href="/">
                        <svg @*width="300" height="120"*@ viewBox="0 0 90 110" xmlns="http://www.w3.org/2000/svg" class="" data-sentry-element="Image" data-sentry-source-file="logo.tsx"
                             fetchpriority="high" width="96" height="70" decoding="async" data-nimg="1" style="color: transparent;">
                            <defs>
                                <!-- Gradient for the main logo -->
                                <linearGradient id="glowGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                                    <stop offset="0%" style="stop-color:#FF6B9D;stop-opacity:1" />
                                    <stop offset="50%" style="stop-color:#C44569;stop-opacity:1" />
                                    <stop offset="100%" style="stop-color:#F8B500;stop-opacity:1" />
                                </linearGradient>

                                <!-- Gradient for the glow effect -->
                                <radialGradient id="glowEffect" cx="50%" cy="50%" r="50%">
                                    <stop offset="0%" style="stop-color:#FFD700;stop-opacity:0.8" />
                                    <stop offset="70%" style="stop-color:#FF6B9D;stop-opacity:0.4" />
                                    <stop offset="100%" style="stop-color:#C44569;stop-opacity:0.1" />
                                </radialGradient>

                                <!-- Shadow filter -->
                                <filter id="dropShadow" x="-20%" y="-20%" width="140%" height="140%">
                                    <feDropShadow dx="2" dy="4" stdDeviation="3" flood-color="#00000030" />
                                </filter>
                            </defs>

                            <!-- Background glow effect -->
                            <circle cx="60" cy="60" r="45" fill="url(#glowEffect)" opacity="0.6" />

                            <!-- Main logo icon - stylized makeup brush/lipstick -->
                            <g transform="translate(30, 20)">
                                <!-- Lipstick body -->
                                <rect x="15" y="35" width="12" height="25" rx="6" fill="url(#glowGradient)" filter="url(#dropShadow)" />

                                <!-- Lipstick tip -->
                                <ellipse cx="21" cy="32" rx="6" ry="8" fill="#FF6B9D" />

                                <!-- Decorative sparkles -->
                                <g fill="#FFD700">
                                    <polygon points="45,15 47,20 52,18 48,22 50,27 45,24 40,27 42,22 38,18 43,20" opacity="0.8" />
                                    <polygon points="8,50 9,52 12,51 10,54 11,57 8,55 5,57 6,54 4,51 7,52" opacity="0.9" />
                                    <circle cx="50" cy="45" r="1.5" opacity="0.7" />
                                    <circle cx="10" cy="25" r="1" opacity="0.8" />
                                </g>
                            </g>

                            <!-- Brand name -->
                            <text x="120" y="45" font-family="Arial, sans-serif" font-size="32" font-weight="bold" fill="url(#glowGradient)" filter="url(#dropShadow)">Glow</text>
                            <text x="120" y="75" font-family="Arial, sans-serif" font-size="28" font-weight="300" fill="#C44569">Vibe</text>

                            <!-- Tagline -->
                            <text x="120" y="95" font-family="Arial, sans-serif" font-size="12" fill="#888" font-style="italic">Beauty that Radiates</text>

                            <!-- Decorative line -->
                            <line x1="120" y1="80" x2="200" y2="80" stroke="url(#glowGradient)" stroke-width="2" opacity="0.6" />
                        </svg>

                    </a>
                    @using (Html.BeginForm("", "", FormMethod.Get, new { @Class = "z-top-of-chatbot-plus3 relative mx-auto max-w-xl grow flex-wrap rounded border-none lg:flex hidden" }))
                    {
                        <div class="position-relative flex w-full overflow-hidden rounded">
                            <div class="position-absolute right-0 top-0 flex h-full items-center justify-content-center rounded px-1.5">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-search me-1 h-6 w-6 text-text-mediumGray" viewBox="0 0 16 16">
                                    <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0" />
                                </svg>
                                <button type="button" data-test="clear-result" class="flex text-text-mediumGray hidden">
                                    <i class="bi bi-x me-1 h-6 w-6" data-sentry-component="IconClose" data-sentry-source-file="close.tsx"></i>
                                </button>
                            </div>
                            <input autocomplete="off" placeholder="جست‌وجو" class="h-11 flex-1 rounded border border-border-gray-medium py-2.5 pl-2 pr-10 text-body-14 leading-relaxed outline-none placeholder:text-text-mediumGray focus:border-pink-200 md:min-w-[520px] lg:text-body-16" />
                        </div>
                        <div data-test="search-result" class="z-10 w-full rounded lg:right-0 lg:top-full lg:mr-0 lg:mt-1 lg:overflow-y-auto lg:border lg\:border-border-gray-medium lg:bg-white lg:px-1 lg:shadow-md hidden"></div>
                    }

                </div>
                <div class="flex items-center gap-2 md:gap3 lg:justify-end lg:gap-5">
                    <label class="mr-auto flex pointer-event items-center gap-2 rounded-lg text-xs text-neutral-500 lg:hidden">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-search h-6 text-text-black" viewBox="0 0 16 16">
                            <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0" />
                        </svg>
                    </label>
                    <div class="invisible position-fixed left-0 left-0 top-0 -z-10 h-full w-screen opacity-0 transition-all ease-in-out lg:hidden duration-300" data-sentry-component="Drawer" data-sentry-source-file="index.tsx">
                        <label class="position-absolute top-0 -z-10 h-screen w-full bg-black bg-opacity-60 hidden"></label>
                        <div class="position-relative flex h-full flex-column overflow-x-hidden bg-white transition-all duration-300 ease-in-out header-search">
                            <div class="flex h-14 w-full justify-content-between text-text-black shadow-sm" data-sentry-component="DrawerHeader" data-sentry-source-file="drawer-header.tsx">
                                <div></div>
                                <span class="bg-white text-base font-medium">جست و جو</span>
                                <label class="pointer-event">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-x h-6 w-6 text-text-black" viewBox="0 0 24 24" data-sentry-element="svg" data-sentry-source-file="close.tsx" data-sentry-component="IconClose">
                                        <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708" />
                                    </svg>
                                </label>
                            </div>
                            <div class="position-relative px-2 py-4">
                                <div class="position-relative flex w-full overflow-hidden rounded">
                                    <div class="position-absolute right-0 top-0 flex h-full items-center justify-content-center rounded px-1.5">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-search me-1 h-6 w-6 text-text-mediumGray" viewBox="0 0 16 16" data-sentry-element="svg" data-sentry-component="IconSearchNormal" data-sentry-source-file="search-normal.tsx">
                                            <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0" />
                                        </svg>
                                        <button type="button" data-test="clear-result" class="flex text-text-mediumGray hidden">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-x me-1 h-6 w-6" viewBox="0 0 24 24" data-sentry-element="svg" data-sentry-source-file="close.tsx" data-sentry-component="IconClose">
                                                <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708" />
                                            </svg>
                                        </button>
                                    </div>
                                    <input autocomplete="off" placeholder="جست و جو" class="h-11 flex-1 rounded border border-border-gray-medium py-2.5 pl-2 pr-10 text-body-14 leading-relaxed outline-none placeholder:text-text-mediumGray focus:border-pink-200 md:min-w-[520px] lg:text-body-16" type="text" name="query" />
                                </div><div data-test="search-result" class="z-10 w-full rounded py-2 lg:absolute lg:right-0 lg:top-full lg:mr-0 lg:mt-1 lg:overflow-y-auto lg:border lg:border-border-gray-medium lg:bg-white lg:px-1 lg:shadow-md flex">
                                    <div class="position-relative w-full leading-4 lg:mt-0">
                                        <div class="mt-2">
                                            <span class="mb-18 mt-2 text-body-14 text-text-mediumGray lg:mb-7 lg:mt4 lg:px-1 lg:text-body-16 hidden" data-test="search-result--empty">
                                                برای جست و جوی شما نتیجه ای یافت نشد
                                            </span>
                                            0
                                            <div class="flex w-full flex-column gap-4 rounded-md bg-white pb-2 pt-6 text-text-black first-of-type:!pt-0 lg:mt-0 lg:px-1" data-sentry-component="Suggestions" data-sentry-source-file="suggestions.tsx">
                                                <div class="flex flex-row items-center pr-2">
                                                    <span class="text-sm-start fw-bold lg:text-base"></span>
                                                </div>
                                                <div class="flex flex-column align-items-start gap-4 overflow-auto lg:overflow-hidden lg:pl-0" data-test="search-result--popular">
                                                    <div class="navigation-wrapper group position-relative w-full flex">
                                                        <div class="keen-slider" data-keen-slider-reverse="">
                                                            <!--پرطرفدار-->
                                                            <div class="keen-slider__slide max-w-fit w-full min-w-fit overflow-visible whitespace-nowrap" style="transform: translate3d(402.867px, 0px, 0px);">

                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="z-top-of-chatbot-plus2 position-fixed inset-0 hidden bg-gray-900 opacity-40 lg:block" data-sentry-component="Backdrop" data-sentry-source-file="backdrop.tsx"></div>
                            </div>
                        </div>
                    </div>
                    @if (Session["UserId"] == null)
                    {
                        <button class="position-relative flex items-center justify-content-center overflow-hidden rounded text-body-14 focus-visible:outline-none px-4 fw-bold pr-3 border-primary-main hover:border-primary-shade-700 disabled:border-border-pink py-[7px] !border text-primary-main hover:text-primary-shade-700 disabled:text-primary-shade-200 lg:w-30 bg-white" style="width: 120px; height: 39.3px;" id="btnLogin">
                            <span class="flex items-center position-relative z-10 gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" class="bi bi-box-arrow-in-right h-6 w-6" viewBox="0 0 16 16" data-sentry-element="svg" data-sentry-source-file="Login.tsx">
                                    <path fill-rule="evenodd" d="M6 3.5a.5.5 0 0 1 .5-.5h8a.5.5 0 0 1 .5.5v9a.5.5 0 0 1-.5.5h-8a.5.5 0 0 1-.5-.5v-2a.5.5 0 0 0-1 0v2A1.5 1.5 0 0 0 6.5 14h8a1.5 1.5 0 0 0 1.5-1.5v-9A1.5 1.5 0 0 0 14.5 2h-8A1.5 1.5 0 0 0 5 3.5v2a.5.5 0 0 0 1 0z" />
                                    <path fill-rule="evenodd" d="M11.854 8.354a.5.5 0 0 0 0-.708l-3-3a.5.5 0 1 0-.708.708L10.293 7.5H1.5a.5.5 0 0 0 0 1h8.793l-2.147 2.146a.5.5 0 0 0 .708.708z" />
                                </svg>
                                ورود
                            </span>
                        </button>
                    }
                    else if (Convert.ToBoolean(Session["IsAdmin"]) == false)
                    {

                    }
                    else if (Convert.ToBoolean(Session["IsAdmin"]) == true)
                    {
                        <span>شما ادمین </span>
                    }
                    <a class="flex items-center" aria-label="Cart" href="/">
                        <div class="position-relative" data-sentry-component="CartCounterButton" data-sentry-source-file="cart-counter-button.tsx">
                            <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" class="bi bi-cart2 h-6 w-6 text-text-black" viewBox="0 0 16 16">
                                <path d="M0 2.5A.5.5 0 0 1 .5 2H2a.5.5 0 0 1 .485.379L2.89 4H14.5a.5.5 0 0 1 .485.621l-1.5 6A.5.5 0 0 1 13 11H4a.5.5 0 0 1-.485-.379L1.61 3H.5a.5.5 0 0 1-.5-.5M3.14 5l1.25 5h8.22l1.25-5zM5 13a1 1 0 1 0 0 2 1 1 0 0 0 0-2m-2 1a2 2 0 1 1 4 0 2 2 0 0 1-4 0m9-1a1 1 0 1 0 0 2 1 1 0 0 0 0-2m-2 1a2 2 0 1 1 4 0 2 2 0 0 1-4 0" />
                            </svg>
                        </div>
                    </a>
                </div>
                @Html.Action("Category", "Home", new { section = 1, area = "" })
            </div>
            <div class="hidden h-11 w-full bg-neutral-800 transition-transform duration-300 lg:flex" data-sentry-component="SubMenu" data-sentry-source-file="sub-menu.tsx">
                <div class="megamenu-container position-relative flex items-center justify-content-start">
                    @Html.Action("Category", "Home", new { section = 2, area = "" })
                </div>
            </div>
        </header>
        <div class="left-to-right absolute"></div>
        <main class="position-relative w-full overflow-hidden">
            @RenderBody()
        </main>
        <footer class="layout-container flex flex-column gap-4 bg-gray-800 pb-3 pt-4 lg:gap-6 lg:pt-12" data-sentry-component="Footer" data-sentry-source-file="footer.tsx">
            <section class="w-full gap-6 lg:grid lg:grid-cols-2">
                <div class="col-span-full flex w-full lg:hidden flex flex-column items-center gap-2 lg:gap-3" data-sentry-component="SocialIcons" data-sentry-source-file="social-icons.tsx">
                    <div class="flex w-full justify-content-center gap-3">
                        <a href="" class="group flex h-6 w-6 items-center justify-content-center" aria-label="Pinterest" rel="noreferrer nofollow" target="_blank">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="CurrentColor" class="bi bi-telegram w-6 h-6 text-light" viewBox="0 0 16 16" style="border-radius: 50%;">
